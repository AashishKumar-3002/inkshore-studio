# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string.
DATABASE_URL="postgresql://inkdrop:inkdrop@localhost:5432/inkdrop"
# Set to "true" for managed Postgres that needs TLS (Neon, Supabase, RDS…).
DATABASE_SSL="false"

# Signs session cookies.  Generate with:  openssl rand -base64 32
AUTH_SECRET=""

# Encrypts users' provider API keys at rest (AES-256-GCM).
# Generate with:  openssl rand -hex 32
# Changing this makes every stored key undecryptable — users must re-enter them.
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Optional — OAuth sign-in.  Each provider only appears on the sign-in page
# when both of its variables are set.
# ---------------------------------------------------------------------------
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Canonical URL, needed when running behind a reverse proxy.
# AUTH_URL="https://your-domain.example"

# Public product-site origin, used for social sharing images.
# NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# ---------------------------------------------------------------------------
# Optional — instance-wide fallback model keys.  A user's own key (set in
# Settings) always wins; these let you run an instance where people don't
# need their own.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
NVIDIA_API_KEY=""

# Cover art always goes through the OpenAI Images API, whatever your writing
# model is — Anthropic has no image-generation endpoint.

# Point NVIDIA NIM at a self-hosted NIM container instead of the hosted API.
# NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"

# Attribution shown on your OpenRouter activity page.
# OPENROUTER_SITE_URL="https://your-domain.example"
# OPENROUTER_SITE_NAME="Inkshore Studio"
