{
  "name": "inkshore-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "db:import-legacy": "tsx scripts/import-legacy-json.ts",
    "desktop:prepare": "next build --webpack && node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:prepare && npm --prefix desktop start",
    "desktop:dist": "npm run desktop:prepare && npm --prefix desktop run dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@auth/drizzle-adapter": "^1.11.3",
    "@electric-sql/pglite": "^0.5.8",
    "@openai/codex-sdk": "^0.154.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "epub-gen-memory": "^1.1.2",
    "fractional-indexing": "^4.0.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.37.0",
    "nanoid": "^6.0.1",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.8.0",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.263"
  }
}
